{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ITA Canonical English Mission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "time",
    "visual",
    "competencies",
    "prerequisites",
    "objective",
    "why",
    "core",
    "scenario",
    "exercise",
    "quiz",
    "mistake",
    "evidence",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^L\\d{2}-M\\d{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "time": {
      "type": "string",
      "minLength": 1
    },
    "visual": {
      "type": "string",
      "minLength": 1
    },
    "competencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^L\\d{2}-M\\d{2}$"
      }
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "why": {
      "type": "string",
      "minLength": 1
    },
    "core": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scenario": {
      "type": "string",
      "minLength": 1
    },
    "exercise": {
      "type": "string",
      "minLength": 1
    },
    "quiz": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "string",
            "minLength": 1
          }
        ],
        "minItems": 2,
        "maxItems": 2
      }
    },
    "mistake": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
