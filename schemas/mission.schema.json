{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ITA Canonical Mission",
  "type": "object",
  "required": [
    "id",
    "level",
    "status",
    "competencies",
    "prerequisites",
    "source_ids",
    "illustration_id"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "level": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "content_locked",
        "published"
      ]
    },
    "competencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "illustration_id": {
      "type": "string"
    },
    "localized_content": {
      "description": "Stored separately under content/<locale>/",
      "type": "boolean"
    }
  }
}